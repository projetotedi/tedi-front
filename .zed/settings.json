{
  "languages": {
    "TypeScript": {
      "formatter": {
        "external": { "command": "oxfmt", "arguments": ["--stdin-filepath", "{buffer_path}"] }
      },
      "format_on_save": "on"
    },
    "TSX": {
      "formatter": {
        "external": { "command": "oxfmt", "arguments": ["--stdin-filepath", "{buffer_path}"] }
      },
      "format_on_save": "on"
    }
  },
  "lsp": {
    "oxc": {
      "settings": {
        "lint": { "run": "onType" }
      }
    }
  },
  "file_scan_exclusions": ["**/node_modules", "**/dist", "**/.env"]
}
